{
	"schemaVersion": 1,
	"id": "relics",
	"version": "${version}",
	"name": "relics",
	"description": "A mod that lets server owners create custom tables of items that players pick up through opening randomly spawning relics",
	"authors": [
		"MessyPrincy"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/MessyPrincy/relics"
	},
	"license": "CC0-1.0",
	"icon": "assets/relics/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.messyprincy.Relics"
		],
		"client": [
			"dev.messyprincy.client.RelicsClient"
		]
	},
	"mixins": [
		"relics.mixins.json",
		{
			"config": "relics.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}